# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/

# .NET / VS
*.user
.vs/
*.suo
project.lock.json

# Rider / VS Code
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# CodeCarver: carved output, scratch corpora, and fetched toolchains are never committed
.carved/
.corpus/
.oracle-cpp/
.toolchains/

# Filled-in presets carry real repo paths/roots — keep only the .example templates
presets/*.ps1
!presets/*.example.ps1

# Release artifacts (produced by release.ps1) are never committed — they live on the git remote's
# releases, traceable by the commit SHA stamped in each zip.
dist/
*.tmp
.claude/scheduled_tasks.lock

# Machine-local MCP config; never belongs in the repo.
.mcp.json
**/discordinator/

perf-baseline.json

# Test coverage output (coverlet / VSTest)
TestResults/
**/TestResults/

# Generated carve output for the worked examples (regenerate with run.ps1/run.sh)
examples/multistage-firmware/out/
examples/mixed-cpp-firmware/out/
examples/csharp-app/out/

# Example carve outputs (regenerated by run.ps1 / run.sh)
examples/*/out/

# Filled-in TOML presets carry real repo paths/roots too
presets/*.toml

# Made from examples/hellbuild/cafe.c.in by the tests and the oracle (a non-ASCII name is not checked in)
examples/hellbuild/src/caf*.c
