# Text files are stored with LF in the repository (every tracked text file already is, so this needs no
# renormalisation commit); the working-tree line ending follows core.autocrlf unless pinned below.
* text=auto

# Shell scripts must stay LF - CRLF breaks the `#!/usr/bin/env bash` shebang under WSL/Linux
# (`bad interpreter: .../bash^M`). These are run inside WSL by the linker-map / C++ link oracles.
*.sh text eol=lf

# PowerShell scripts check out as CRLF on every platform (Windows PowerShell 5.1 is the target; pwsh reads
# either). They must also stay ASCII-only: 5.1 reads a BOM-less file as ANSI and misparses e.g. an em dash.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Example inputs and their checked-in carved outputs are quoted byte-for-byte (README size lines, the
# ExamplesTests drift checks), so they must check out identically everywhere: a CRLF checkout on a Windows
# runner grew every count. The example scripts keep their own rules above (*.ps1 CRLF, *.sh LF).
examples/** text eol=lf
examples/**/*.ps1 text eol=crlf
# The CRLF horror must keep its CRLF line endings (and its BOM and form feeds).
examples/eldritch/src/crlf.c -text

# Visual Studio solution files are CRLF by convention.
*.sln text eol=crlf

# Binaries: never apply text/EOL normalisation or text diffs.
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.zip   binary
*.7z    binary
*.pml   binary
*.bin   binary
*.pyc   binary
*.png   binary
*.jpg   binary
*.ico   binary

# The vendored CodeSpawner generator is a native-AOT binary (also covered by *.exe above).
tools/codespawner/*.exe binary
