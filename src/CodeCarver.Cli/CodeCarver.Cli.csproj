<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeCarver.Core\CodeCarver.Core.csproj" />
    <ProjectReference Include="..\CodeCarver.Frontend\CodeCarver.Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TOML config parser (human-friendly config format for the carve config file). -->
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>CodeCarver</Product>
    <!-- The command every doc uses: codecarver(.exe) / codecarver.dll. -->
    <AssemblyName>codecarver</AssemblyName>
    <!-- Fallback only (no git): the real version is 1.0.<commit-count> set by StampGitSha below, so the
         patch number bumps by one on every commit/push (like CodeCompass 1.0.NNN). -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The git version stamp (1.0.<count>+<sha>[-dirty]) is the StampGitSha target in Directory.Build.targets,
       so Core and Frontend carry the same version as this CLI. -->

</Project>
