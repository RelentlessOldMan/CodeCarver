<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeCarver.Core\CodeCarver.Core.csproj" />
    <ProjectReference Include="..\CodeCarver.Frontend\CodeCarver.Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TOML config parser (human-friendly config format for the carve config file). -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>CodeCarver</Product>
    <!-- The command every doc uses: codecarver(.exe) / codecarver.dll. -->
    <AssemblyName>codecarver</AssemblyName>
    <!-- Fallback only (no git): the real version is 1.0.<commit-count> set by StampGitSha below, so the
         patch number bumps by one on every commit/push (like CodeCompass 1.0.NNN). -->
    <Version>1.0.0</Version>
    <!-- A run scans thousands of files on every core and allocates as it goes: with the default (workstation) GC the
         threads queue on collections, and the emitted-tree check took 4x longer. Server GC with DATAS (heaps sized to
         the work) was both faster and smaller at peak on a 700-file bench: check 19 s -> 9 s, peak 1.0 -> 0.7 GB. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <!-- Instrumented tier-0 code (dynamic PGO) ran the parse on dozens of threads at once and its re-JIT work was a
         third of a run's CPU: off, a 1,351-file #if-heavy bench 19.3 -> 12.6 s CPU and 7.5 -> 6.5 s wall; a 6,000-file
         log-heavy one and a 12-file one also faster (review CPU, Phase 2). DOTNET_TieredPGO=1 still turns it on. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Most of a run's peak was room the GC kept, not data (one compaction after the graph build: 2.0 -> 1.08 GB).
         ConserveMemory has it compact the old generation sooner: a macro-heavy tree's peak 2.0 -> 1.7 GB. Written into
         the runtimeconfig, so every run has it; DOTNET_GCConserveMemory still overrides (0 = off). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!-- The git version stamp (1.0.<count>+<sha>[-dirty]) is the StampGitSha target in Directory.Build.targets,
       so Core and Frontend carry the same version as this CLI. -->

</Project>
